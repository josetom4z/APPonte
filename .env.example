# -------------------------------------------------------------
# APPonte - Configurações de Variáveis de Ambiente
# -------------------------------------------------------------

# Configuração da Aplicação
NODE_ENV=development
PORT=3000
FRONTEND_PORT=5173

# MongoDB
MONGO_ROOT_USER=admin
MONGO_ROOT_PASSWORD=secretpassword
MONGO_DB_NAME=apponte
MONGODB_URI=mongodb://admin:secretpassword@localhost:27017/apponte?authSource=admin

# JWT & Segurança
JWT_SECRET=apponte_super_jwt_secret_dev_key_2026_change_in_production
JWT_EXPIRATION=15m
JWT_REFRESH_SECRET=apponte_super_refresh_jwt_dev_key_2026_change_in_production
JWT_REFRESH_EXPIRATION=7d
BCRYPT_SALT_ROUNDS=10

# CORS
CORS_ORIGINS=http://localhost:5173,http://localhost,http://localhost:80

# Uploads
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=25

# Frontend (Vite)
VITE_API_URL=/api
VITE_APP_NAME="APPonte"
